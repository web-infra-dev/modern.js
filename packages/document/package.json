{
  "name": "@modern-js/main-doc",
  "description": "Documentation of modern.js framework",
  "type": "module",
  "homepage": "https://modernjs.dev",
  "bugs": "https://github.com/web-infra-dev/modern.js/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/document"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "framework",
    "modern",
    "modern.js"
  ],
  "scripts": {
    "dev": "rs doc",
    "build": "rs doc build",
    "preview": "rs doc preview"
  },
  "version": "3.9.3",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@modern-js/sandpack-react": "workspace:*",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@rsbuild/plugin-sass": "2.0.1",
    "@rspress/core": "2.0.23",
    "@rspress/plugin-llms": "2.0.2",
    "@rspress/shared": "2.0.2",
    "@shikijs/transformers": "^3.23.0",
    "@types/fs-extra": "9.0.13",
    "@types/node": "^20",
    "classnames": "^2.5.1",
    "clsx": "^1.2.1",
    "fs-extra": "^10.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rsbuild-plugin-open-graph": "1.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "build",
          "^build",
          "{projectRoot}/docs/**/*"
        ],
        "outputs": [
          "{projectRoot}/doc_build"
        ]
      }
    }
  }
}
