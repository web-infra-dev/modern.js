{
  "name": "@modern-js/image",
  "version": "3.9.3",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/index.d.ts"
      ],
      "runtime": [
        "./dist/runtime.d.ts"
      ],
      "types": [
        "./dist/types.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rs lib",
    "dev": "rs lib --watch"
  },
  "dependencies": {
    "@rsbuild-image/core": "0.0.1-next.16",
    "@rsbuild-image/react": "0.0.1-next.16",
    "ipx": "^3.1.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@modern-js/app-tools": "workspace:*",
    "@types/node": "^20",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5"
  }
}
