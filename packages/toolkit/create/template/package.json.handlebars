{
  "name": "{{packageName}}",
  "version": "0.1.0",
  "scripts": {
    "dev": "modern dev",
    "build": "modern build",
    "serve": "modern serve"{{#if isMcp}},
    "deploy": "modern deploy"{{/if}}{{#unless isSubproject}},
    "prepare": "rs hooks",
    "check": "rs check",
    "lint": "rs lint",
    "format": "rs fmt"{{/unless}}
  },
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "dependencies": {
    "@modern-js/runtime": "{{version}}",
    "react": "^19.2.3",
    "react-dom": "^19.2.0"{{#if isMcp}},
    "@modern-js/mcp-apps": "{{mcpAppsVersion}}",
    "@modern-js/plugin-bff": "{{version}}",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modern-js/server-runtime": "{{version}}",
    "zod": "^4.2.0"{{/if}}{{#if mf}},
    "@module-federation/enhanced": "2.0.0"{{/if}}
  },
  "devDependencies": {
    "@modern-js/app-tools": "{{version}}",
    "@modern-js/tsconfig": "{{version}}",
    "typescript": "{{#if isMcp}}~5.9.3{{/if}}{{#unless isMcp}}~5.7.3{{/unless}}",
    "@types/node": "^20"{{#unless isSubproject}},
    "rstack": "0.8.2"{{/unless}},
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6"{{#if isMcp}},
    "ts-node": "^10.9.2"{{/if}}{{#if mf}},
    "@module-federation/modern-js-v3": "2.0.0"{{/if}}
  }
}
