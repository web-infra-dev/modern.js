{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "types": ["@modern-js/app-tools/types"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "shared", "config", "modern.config.ts", "server"],
  "exclude": ["**/node_modules"]
}
