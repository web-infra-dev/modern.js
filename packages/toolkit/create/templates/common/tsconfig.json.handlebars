{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    "types": ["@modern-js/app-tools/types"],
    "declaration": false,
    "jsx": "preserve",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["shared", "config", "modern.config.ts", "server"{{#if hasUi}}, "src"{{/if}}{{#if isMcp}}, "mcp_tools.ts"{{/if}}{{#if isMcpUi}}, "mcp_apps.ts"{{/if}}{{#if isMcpServer}}, "api"{{/if}}{{#if mf}}, "module-federation.config.ts"{{/if}}],
  "exclude": ["**/node_modules"]
}
