import { defineMcpServer } from '@modern-js/mcp-apps/config';
import { withViewProps } from '@modern-js/mcp-apps/server';
import { addTodo, deleteTodo, listTodos, updateTodo } from './server/store';
import { name, version } from './package.json';

export default defineMcpServer({
  name,
  version,
{{#if mf}}  remotes: [{
    name: 'mcp_ui',
    baseUrl: process.env.MCP_UI_MANIFEST_URL ?? 'http://localhost:8080/static/mf-manifest.json',
    csp: {
      resourceDomains: [process.env.MCP_UI_ORIGIN ?? 'http://localhost:8080'],
      connectDomains: [process.env.MCP_UI_ORIGIN ?? 'http://localhost:8080'],
    },
  }],
{{/if}}  tools: [
    {
      name: 'list_todos',
      description: 'List all todos and open the interactive todo card.',
      inputSchema: {
        type: 'object',
        properties: {},
        additionalProperties: false,
      },
      annotations: { readOnlyHint: true },
      handler: () => {
        const todos = listTodos();
        return withViewProps({
          content: [{ type: 'text', text: JSON.stringify(todos) }],
          structuredContent: { todos },
        });
      },
{{#if mf}}      remote: 'mcp_ui',
      view: { module: './Todos' },
{{/if}}{{#unless mf}}      view: { module: './src/components/Todos.tsx' },
{{/unless}}
    },
    {
      name: 'add_todo',
      description: 'Add a todo with a non-empty title.',
      inputSchema: {
        type: 'object',
        properties: {
          title: {
            type: 'string',
            minLength: 1,
            maxLength: 120,
            pattern: '\\S',
          },
        },
        required: ['title'],
        additionalProperties: false,
      },
      handler: ({ title }) => {
        const todo = addTodo(title);
        return {
          content: [{ type: 'text', text: `Added: ${todo.title}` }],
          structuredContent: { todo },
        };
      },
    },
    {
      name: 'update_todo',
      description:
        'Edit a todo title or set its completion status using its ID from list_todos.',
      inputSchema: {
        type: 'object',
        properties: {
          id: { type: 'string', minLength: 1 },
          completed: { type: 'boolean' },
          title: {
            type: 'string',
            minLength: 1,
            maxLength: 120,
            pattern: '\\S',
          },
        },
        required: ['id'],
        minProperties: 2,
        additionalProperties: false,
      },
      annotations: { destructiveHint: false, idempotentHint: true },
      handler: ({ id, title, completed }) => {
        const todo = updateTodo(id, { title, completed });
        return todo
          ? {
              content: [
                {
                  type: 'text',
                  text: `Updated: ${todo.title} (${todo.completed ? 'completed' : 'active'})`,
                },
              ],
              structuredContent: { todo },
            }
          : {
              isError: true,
              content: [
                {
                  type: 'text',
                  text: 'Todo not found. Refresh the list and try again.',
                },
              ],
            };
      },
    },
    {
      name: 'delete_todo',
      description: 'Delete a todo using its ID from list_todos.',
      inputSchema: {
        type: 'object',
        properties: { id: { type: 'string', minLength: 1 } },
        required: ['id'],
        additionalProperties: false,
      },
      annotations: { destructiveHint: true, idempotentHint: true },
      handler: ({ id }) => {
        const todo = deleteTodo(id);
        return todo
          ? {
              content: [{ type: 'text', text: `Deleted: ${todo.title}` }],
              structuredContent: { todo },
            }
          : {
              isError: true,
              content: [
                {
                  type: 'text',
                  text: 'Todo not found. Refresh the list and try again.',
                },
              ],
            };
      },
    },
  ],
});
