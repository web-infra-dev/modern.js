{
  "name": "@modern-js/mcp-apps-inspector",
  "version": "3.9.1",
  "description": "Development Inspector and sandbox for Modern.js MCP Apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/mcp-apps-inspector"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "modern:source": "./src/index.tsx",
      "import": "./dist/esm/index.mjs",
      "default": "./dist/esm/index.mjs"
    },
    "./server": {
      "types": "./dist/types/sandbox-server.d.ts",
      "modern:source": "./src/sandbox-server.ts",
      "import": "./dist/esm-node/server.mjs",
      "require": "./dist/cjs/server.cjs"
    }
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit",
    "test": "rstest"
  },
  "dependencies": {
    "@modern-js/mcp-apps": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rsbuild/core": "2.2.13",
    "@rslib/core": "1.0.3",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/esm/index.mjs",
        "default": "./dist/esm/index.mjs"
      },
      "./server": {
        "types": "./dist/types/sandbox-server.d.ts",
        "import": "./dist/esm-node/server.mjs",
        "require": "./dist/cjs/server.cjs"
      }
    }
  },
  "types": "./dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "dist/types/sandbox-server.d.ts"
      ]
    }
  }
}
