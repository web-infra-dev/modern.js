{
  "name": "@modern-js/mcp-apps",
  "version": "3.10.3",
  "description": "Independently deployable MCP Apps servers and React views",
  "license": "MIT",
  "homepage": "https://modernjs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/mcp-apps"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./server": {
      "types": "./dist/types/server/index.d.ts",
      "modern:source": "./src/server/index.ts",
      "import": "./dist/esm-node/server.mjs",
      "require": "./dist/cjs/server.cjs"
    },
    "./react": {
      "types": "./dist/types/ui/react.d.ts",
      "modern:source": "./src/ui/react.ts",
      "import": "./dist/esm/react.mjs",
      "default": "./dist/esm/react.mjs"
    },
    "./manifest": {
      "types": "./dist/types/manifest.d.ts",
      "modern:source": "./src/manifest.ts",
      "import": "./dist/esm-node/manifest.mjs",
      "require": "./dist/cjs/manifest.cjs"
    },
    "./mf": {
      "types": "./dist/types/ui/mf.d.ts",
      "modern:source": "./src/ui/mf.tsx",
      "import": "./dist/esm/mf.mjs",
      "default": "./dist/esm/mf.mjs"
    }
  },
  "scripts": {
    "build": "rslib build",
    "test": "rstest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modern-js/server-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "@module-federation/enhanced": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@module-federation/enhanced": {
      "optional": true
    }
  },
  "devDependencies": {
    "@module-federation/enhanced": "2.0.0",
    "@rsbuild/core": "2.2.13",
    "@rslib/core": "1.0.4",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5",
    "@modelcontextprotocol/client": "2.3.1",
    "zod": "^4.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./server": {
        "types": "./dist/types/server/index.d.ts",
        "import": "./dist/esm-node/server.mjs",
        "require": "./dist/cjs/server.cjs"
      },
      "./react": {
        "types": "./dist/types/ui/react.d.ts",
        "import": "./dist/esm/react.mjs",
        "default": "./dist/esm/react.mjs"
      },
      "./manifest": {
        "types": "./dist/types/manifest.d.ts",
        "import": "./dist/esm-node/manifest.mjs",
        "require": "./dist/cjs/manifest.cjs"
      },
      "./mf": {
        "types": "./dist/types/ui/mf.d.ts",
        "import": "./dist/esm/mf.mjs",
        "default": "./dist/esm/mf.mjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "./dist/types/server/index.d.ts"
      ],
      "react": [
        "./dist/types/ui/react.d.ts"
      ],
      "manifest": [
        "./dist/types/manifest.d.ts"
      ],
      "mf": [
        "./dist/types/ui/mf.d.ts"
      ]
    }
  }
}
