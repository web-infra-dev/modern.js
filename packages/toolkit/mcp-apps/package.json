{
  "name": "@modern-js/mcp-apps",
  "version": "3.9.1",
  "description": "Independently deployable MCP Apps servers and React views",
  "license": "MIT",
  "homepage": "https://modernjs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-infra-dev/modern.js",
    "directory": "packages/toolkit/mcp-apps"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE.md",
    "THIRD-PARTY-LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./config": {
      "types": "./dist/types/config.d.ts",
      "modern:source": "./src/config.ts",
      "import": "./dist/esm-node/config.mjs",
      "require": "./dist/cjs/config.cjs"
    },
    "./server": {
      "types": "./dist/types/server.d.ts",
      "modern:source": "./src/server.ts",
      "import": "./dist/esm-node/server.mjs",
      "require": "./dist/cjs/server.cjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "modern:source": "./src/react.ts",
      "import": "./dist/esm/react.mjs",
      "default": "./dist/esm/react.mjs"
    },
    "./build": {
      "types": "./dist/types/build.d.ts",
      "modern:source": "./src/build.ts",
      "import": "./dist/esm-node/build.mjs",
      "require": "./dist/cjs/build.cjs"
    },
    "./hono": {
      "types": "./dist/types/hono.d.ts",
      "modern:source": "./src/hono.ts",
      "import": "./dist/esm-node/hono.mjs",
      "require": "./dist/cjs/hono.cjs"
    },
    "./bff": {
      "types": "./dist/types/bff.d.ts",
      "modern:source": "./src/bff.ts",
      "import": "./dist/esm-node/bff.mjs",
      "require": "./dist/cjs/bff.cjs"
    }
  },
  "scripts": {
    "build": "rslib build && pnpm build:runtime",
    "dev": "rslib build --watch",
    "test": "pnpm build:runtime && rstest",
    "typecheck": "tsc --noEmit",
    "test:deployment": "node scripts/deployment-smoke.mjs",
    "build:runtime": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "zod": "^3.25.76",
    "esbuild": "^0.27.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rslib/core": "1.0.1",
    "@scripts/rstest-config": "workspace:*",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "react": "^19.2.8",
    "typescript": "^5",
    "@module-federation/enhanced": "2.2.1",
    "@rsbuild/core": "2.2.7",
    "@rsbuild/plugin-react": "2.1.0",
    "@types/react-dom": "^19.3.0",
    "react-dom": "^19.2.8"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      "./config": {
        "types": "./dist/types/config.d.ts",
        "import": "./dist/esm-node/config.mjs",
        "require": "./dist/cjs/config.cjs"
      },
      "./server": {
        "types": "./dist/types/server.d.ts",
        "import": "./dist/esm-node/server.mjs",
        "require": "./dist/cjs/server.cjs"
      },
      "./react": {
        "types": "./dist/types/react.d.ts",
        "import": "./dist/esm/react.mjs",
        "default": "./dist/esm/react.mjs"
      },
      "./build": {
        "types": "./dist/types/build.d.ts",
        "import": "./dist/esm-node/build.mjs",
        "require": "./dist/cjs/build.cjs"
      },
      "./hono": {
        "types": "./dist/types/hono.d.ts",
        "import": "./dist/esm-node/hono.mjs",
        "require": "./dist/cjs/hono.cjs"
      },
      "./bff": {
        "types": "./dist/types/bff.d.ts",
        "import": "./dist/esm-node/bff.mjs",
        "require": "./dist/cjs/bff.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "config": [
        "dist/types/config.d.ts"
      ],
      "server": [
        "dist/types/server.d.ts"
      ],
      "react": [
        "dist/types/react.d.ts"
      ],
      "build": [
        "dist/types/build.d.ts"
      ],
      "hono": [
        "dist/types/hono.d.ts"
      ],
      "bff": [
        "dist/types/bff.d.ts"
      ]
    }
  }
}
