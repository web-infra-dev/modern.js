{
  "extends": "@modern-js/tsconfig/base",
  "compilerOptions": {
    // The script runs under the ts-node CLI, which cannot read an `extends`
    // array, so the server preset's module options are inlined here.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "preserve",
    "esModuleInterop": true
  }
}
